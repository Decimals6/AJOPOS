<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".view.ui.main.PrinterPrefFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengaturan Format Nota"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Atur informasi toko dan ukuran kertas printer thermal."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- STORE NAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Toko"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:hint="Masukkan nama toko"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:singleLine="true" />

        <!-- STORE ADDRESS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alamat Toko"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStoreAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:gravity="top|start"
            android:hint="Masukkan alamat toko"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:maxLines="4" />

        <!-- STORE PHONE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nomor Telepon"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStorePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:hint="Masukkan nomor telepon"
            android:inputType="phone"
            android:maxLines="1"
            android:singleLine="true" />

        <!-- PAPER WIDTH -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ukuran Kertas"
            android:textStyle="bold"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/rgPaperWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbPaper58"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="58 mm (Printer Mini / Portable)" />

            <RadioButton
                android:id="@+id/rbPaper58On80"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="58 mm (Printer 80 mm pakai Sekat)" />

            <RadioButton
                android:id="@+id/rbPaper80"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="80 mm (Full)" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Pilihan 58 mm (32 karakter) atau 80 mm (48 karakter)."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- SAVE BUTTON -->

        <Button
            android:id="@+id/btnSavePrinterPref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Pengaturan" />

        <Button
            android:id="@+id/btnPreviewReceipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preview Nota" />

        <!-- RESET BUTTON -->

        <Button
            android:id="@+id/btnResetPrinterPref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset ke Default" />

    </LinearLayout>

</ScrollView>
