<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buat Nota"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: Rp 0"
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <!-- Pilihan tipe transaksi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipe Transaksi"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

        <RadioGroup
            android:id="@+id/rgTipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@id/rbDineIn">

            <RadioButton
                android:id="@+id/rbDineIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dine-in" />

            <RadioButton
                android:id="@+id/rbTakeaway"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Takeaway"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <EditText
            android:id="@+id/etPelanggan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama pelanggan (wajib)"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Metode Pembayaran"
            android:textSize="14sp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"/>

        <RadioGroup
            android:id="@+id/rgPembayaran"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASH"/>

            <RadioButton
                android:id="@+id/rbQris"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QRIS"
                android:layout_marginStart="16dp"/>
        </RadioGroup>

        <!-- Input cash hanya muncul jika pilih CASH -->
        <EditText
            android:id="@+id/etCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Masukkan nominal CASH"
            android:inputType="number"
            android:visibility="gone"/>


        <LinearLayout
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batal" />

            <Button
                android:id="@+id/btnCreate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buat Nota"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</layout>